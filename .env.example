# WiScribbles Phase 2 — environment template
#
# Copy to `.env.local` for development and `.env.production` on the VPS.
# NEVER commit a filled-in copy. The Phase 1 repo committed a Firebase Admin
# service-account JSON to a public repository; that key must be treated as
# compromised. Credentials live here and nowhere else.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for email verification links and by
# lib/apiUtils.js getBaseUrl().
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase — client SDK
# Safe to expose: these identify the project, they do not authorise anything.
# Access is governed by firestore.rules.
# Firebase console → Project settings → General → Your apps → SDK setup
#
# NOT in the Admin SDK JSON. These come from a registered WEB APP, which is a
# separate thing you create in the console. If apiKey, messagingSenderId or
# appId are nowhere to be found, no Web app has been registered yet.
# Copy STORAGE_BUCKET exactly — newer projects end .firebasestorage.app,
# older ones .appspot.com, and it cannot be guessed from the project ID.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (SERVER ONLY, never prefixed NEXT_PUBLIC_)
# Full admin access, bypasses all security rules. Treat like a root password.
# Firebase console → Project settings → Service accounts → Generate new private key
#
# TWO ACCEPTED SHAPES — set ONE. lib/firebase-admin.js reads either.
#
#   (A) The whole downloaded JSON on a single line. Simplest; no newline
#       escaping to get wrong. Preferred.
#   (B) The three fields separately, for hosts whose secret manager dislikes
#       large JSON blobs. For the private key keep the literal \n sequences
#       exactly as the JSON has them, wrapped in double quotes.
#
# Copy the values out, then DELETE the downloaded file.
# ---------------------------------------------------------------------------

# (A)
FIREBASE_SERVICE_ACCOUNT=

# (B)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Email — Resend (verification, approval, admin feedback)
# Without RESEND_API_KEY, development logs mail to the console instead of
# sending; production refuses to send and logs an error.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="WiScribbles <notifications@your-verified-domain.com>"

# ---------------------------------------------------------------------------
# Stripe — subscriptions for Attorneys and Businesses.
# Solo USD 50 / Chambers USD 150 / Enterprise USD 350 per month.
# Notaries and Commissioners of Oaths are NEVER charged — they are paid from
# the service fee. lib/plans.js refuses to bill those roles.
#
# Stripe is NOT used for payouts. Connect cross-border payouts reach only the
# US, UK, EEA, Canada and Switzerland, so they cannot pay a Caribbean notary.
# See PROVIDER_LIMITATIONS in lib/payments/provider.js.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# WiPay — Caribbean card collection (Guyana, Jamaica, Trinidad, Barbados,
# Grenada). Used for one-off fees from clients in those countries.
#
# WIPAY_API_KEY IS A SERVER SECRET. The payment request endpoint is
# unauthenticated, so the response hash is the only thing preventing a forged
# "payment succeeded" callback. If this key leaks, anyone can forge one.
#
# WIPAY_ENVIRONMENT: "sandbox" or "live". In sandbox the adapter falls back to
# WiPay's published test merchant (1234567890 / 123) when these are blank.
# WIPAY_COUNTRY: default processing platform — BB, GD, GY, JM or TT.
# ---------------------------------------------------------------------------
WIPAY_ENVIRONMENT=sandbox
WIPAY_COUNTRY=GY
WIPAY_ACCOUNT_NUMBER=
WIPAY_API_KEY=
WIPAY_ORIGIN=wiscribbles

# ---------------------------------------------------------------------------
# Identity verification — Stage 2.
# Provider-agnostic adapter; Didit is the live provider, Persona swappable.
# ---------------------------------------------------------------------------
KYC_PROVIDER=didit
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# ZegoCloud — video sessions.
# The server secret must never carry a NEXT_PUBLIC_ prefix. Phase 1 exposed it
# as NEXT_PUBLIC_ZEGOCLOUD_SERVER_SECRET, shipping it to every browser and
# letting anyone mint a token for any room. Tokens are now minted server-side
# at /api/zego-token.
# ---------------------------------------------------------------------------
ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=

# ---------------------------------------------------------------------------
# File storage — Firebase Storage. No separate vendor and no extra keys.
# The bucket is NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET, set above.
#
# Cloudinary was removed on 18 Oct 2026. It had been used with an UNSIGNED
# upload preset and the cloud name hardcoded in client-side code, so anyone
# reading the page source could upload to the account. Uploads now go through
# /api/uploads, which authenticates the caller and enforces the 25MB limit and
# the permitted content types server-side, with storage.rules behind it.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — CURRENTLY UNUSED.
# lib/supabase.js creates a client that no file imports, and RealtimeSync.js
# does not use Supabase despite what the README claims. Left commented rather
# than deleted, pending a decision to either wire it or drop the dependency.
# Phase 2 realtime (Go Live toggle, jurisdiction queue) uses Firestore
# onSnapshot.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
