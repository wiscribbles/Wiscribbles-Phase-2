# WiScribbles Phase 2 — environment template
#
# Copy to `.env.local` for development and `.env.production` on the VPS.
# NEVER commit a filled-in copy. The Phase 1 repo committed a Firebase Admin
# service-account JSON to a public repository; that key must be treated as
# compromised. Credentials live here and nowhere else.

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for email verification links and by
# lib/apiUtils.js getBaseUrl().
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Firebase — client SDK
# Safe to expose: these identify the project, they do not authorise anything.
# Access is governed by firestore.rules.
# Firebase console → Project settings → General → Your apps → SDK setup
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ---------------------------------------------------------------------------
# Firebase — Admin SDK (SERVER ONLY, never prefixed NEXT_PUBLIC_)
# Full admin access, bypasses all security rules. Treat like a root password.
# Firebase console → Project settings → Service accounts → Generate new private key
#
# TWO ACCEPTED SHAPES — set ONE. lib/firebase-admin.js reads either.
#
#   (A) The whole downloaded JSON on a single line. Simplest; no newline
#       escaping to get wrong. Preferred.
#   (B) The three fields separately, for hosts whose secret manager dislikes
#       large JSON blobs. For the private key keep the literal \n sequences
#       exactly as the JSON has them, wrapped in double quotes.
#
# Copy the values out, then DELETE the downloaded file.
# ---------------------------------------------------------------------------

# (A)
FIREBASE_SERVICE_ACCOUNT=

# (B)
# FIREBASE_ADMIN_PROJECT_ID=
# FIREBASE_ADMIN_CLIENT_EMAIL=
# FIREBASE_ADMIN_PRIVATE_KEY=""

# ---------------------------------------------------------------------------
# Email — Resend (verification, approval, admin feedback)
# Without RESEND_API_KEY, development logs mail to the console instead of
# sending; production refuses to send and logs an error.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM="WiScribbles <notifications@your-verified-domain.com>"

# ---------------------------------------------------------------------------
# Stripe — Stage 2. Platform fees (Billing) and notary payouts (Connect).
# OPEN RISK: confirm Stripe supports payouts to Guyanese bank accounts before
# building against Connect. See docs/PHASE2_PLAN.md, Open Risks #1.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_CLIENT_ID=

# ---------------------------------------------------------------------------
# Identity verification — Stage 2.
# Provider-agnostic adapter; Didit is the live provider, Persona swappable.
# ---------------------------------------------------------------------------
KYC_PROVIDER=didit
DIDIT_API_KEY=
DIDIT_WEBHOOK_SECRET=
# PERSONA_API_KEY=
# PERSONA_TEMPLATE_ID=

# ---------------------------------------------------------------------------
# ZegoCloud — video sessions.
# The server secret must never carry a NEXT_PUBLIC_ prefix. Phase 1 exposed it
# as NEXT_PUBLIC_ZEGOCLOUD_SERVER_SECRET, shipping it to every browser and
# letting anyone mint a token for any room. Tokens are now minted server-side
# at /api/zego-token.
# ---------------------------------------------------------------------------
ZEGOCLOUD_APP_ID=
ZEGOCLOUD_SERVER_SECRET=

# ---------------------------------------------------------------------------
# Cloudinary — certificate and document uploads.
# Phase 1 used an UNSIGNED upload preset with the cloud name hardcoded in the
# client, so anyone could upload to the account. Stage 2 moves to signed
# uploads; the API secret is server-side only.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Supabase — CURRENTLY UNUSED.
# lib/supabase.js creates a client that no file imports, and RealtimeSync.js
# does not use Supabase despite what the README claims. Left commented rather
# than deleted, pending a decision to either wire it or drop the dependency.
# Phase 2 realtime (Go Live toggle, jurisdiction queue) uses Firestore
# onSnapshot.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
